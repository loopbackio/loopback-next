{
  "name": "@loopback/boot",
  "description": "A collection of Booters for LoopBack 4 Applications",
  "version": "9.0.0",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "IBM Corp. and LoopBack contributors",
  "copyright.owner": "IBM Corp. and LoopBack contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/loopbackio/loopback-next.git",
    "directory": "packages/boot"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "acceptance": "lb-mocha \"dist/__tests__/acceptance/**/*.js\"",
    "build": "lb-tsc",
    "clean": "lb-clean loopback-boot*.tgz dist *.tsbuildinfo package",
    "pretest": "npm run build",
    "integration": "lb-mocha \"dist/__tests__/integration/**/*.js\"",
    "test": "lb-mocha \"dist/__tests__/**/*.js\"",
    "unit": "lb-mocha \"dist/__tests__/unit/**/*.js\"",
    "verify": "npm pack && tar xf loopback-boot*.tgz && tree package && npm run clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "peerDependencies": {
    "@loopback/core": "^7.0.0"
  },
  "dependencies": {
    "@loopback/model-api-builder": "^8.0.0",
    "@loopback/repository": "^9.0.0",
    "@loopback/service-proxy": "^9.0.0",
    "@types/debug": "^4.1.13",
    "debug": "^4.4.3",
    "glob": "^13.0.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@loopback/build": "^13.0.0",
    "@loopback/core": "^8.0.0",
    "@loopback/eslint-config": "^17.0.0",
    "@loopback/rest": "^16.0.0",
    "@loopback/rest-crud": "^0.20.0",
    "@loopback/testlab": "^9.0.0",
    "@types/node": "^20.19.43"
  }
}
